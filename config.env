# KernelSU Action -- GKI Android 16 (Kernel 6.12)
CONFIG_ENV=config.env

# ============================================================ Kernel source ==
KERNEL_SOURCE=https://android.googlesource.com/kernel/common
KERNEL_SOURCE_BRANCH=android16-6.12
KERNEL_CONFIG=defconfig
KERNEL_IMAGE_NAME=Image
ARCH=arm64

KERNEL_NAME=GKI-KernelSU-SuSFS
ADD_LOCALVERSION_TO_FILENAME=true

EXTRA_CMDS=
CUSTOM_CMDS=

# =================================================================== Clang ==
CLANG_BRANCH=main-kernel-2025
CLANG_VERSION=r547379

USE_CUSTOM_CLANG=false
CUSTOM_CLANG_SOURCE=
CUSTOM_CLANG_BRANCH=

USE_LLVM=true

# ===================================================================== GCC ==
ENABLE_GCC_ARM64=true
ENABLE_GCC_ARM32=true
USE_CUSTOM_GCC_64=false
CUSTOM_GCC_64_SOURCE=
CUSTOM_GCC_64_BRANCH=
CUSTOM_GCC_64_BIN=
USE_CUSTOM_GCC_32=false
CUSTOM_GCC_32_SOURCE=
CUSTOM_GCC_32_BRANCH=
CUSTOM_GCC_32_BIN=

# =============================================================== KernelSU ===
KSU_VARIANT=kernelsu
KSU_REF=main
KSU_HOOK_MODE=auto

KSU_EXPECTED_SIZE=
KSU_EXPECTED_HASH=

# =================================================================== SUSFS ==
ENABLE_SUSFS=true
SUSFS_REPO=https://gitlab.com/simonpunk/susfs4ksu.git
SUSFS_BRANCH=gki-android16-6.12

# ========================================================== Extra patches ===
ENABLE_PATH_UMOUNT=false
ENABLE_HIDE_STUFF=true
ENABLE_KPM=false

# ================================================================ Kconfig ===
ADD_KPROBES_CONFIG=false
ADD_OVERLAYFS_CONFIG=false
DISABLE_LTO=false
DISABLE_CC_WERROR=true
EXTRA_DEFCONFIG=

# ============================================================= AnyKernel3 ===
USE_CUSTOM_ANYKERNEL3=false
CUSTOM_ANYKERNEL3_SOURCE=
CUSTOM_ANYKERNEL3_BRANCH=

# ============================================================== Packaging ===
NEED_DTBO=false
BUILD_BOOT_IMG=false
SOURCE_BOOT_IMAGE=

# ================================================================= Runner ===
ENABLE_CCACHE=false
REMOVE_UNUSED_PACKAGES=true
